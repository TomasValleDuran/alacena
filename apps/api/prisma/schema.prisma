// Alacena schema — mirrors the original supabase/schema.sql.
// Personal app, no auth yet (see roadmap: auth/multi-household come later).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  barcode   String   @unique
  name      String
  brand     String?
  imageUrl  String?  @map("image_url")
  category  String?
  unit      String?
  // pricely extras: description and a BlurHash image placeholder come with the
  // lookup; categories are filled lazily by /products/:id/insights
  description String?
  blurHash    String?  @map("blur_hash")
  categories  String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  stockItem    StockItem?
  shoppingRows ShoppingItem[]

  @@index([barcode])
  @@map("products")
}

model StockItem {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  quantity  Decimal  @default(1) @db.Decimal
  minQty    Decimal? @default(0) @map("min_qty") @db.Decimal
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_items")
}

model ShoppingItem {
  id        String   @id @default(uuid()) @db.Uuid
  // linked catalog product (auto-added from low stock) or null for free-text rows
  productId String?  @map("product_id") @db.Uuid
  name      String?
  quantity  Decimal  @default(1) @db.Decimal
  checked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // NOTE: the "one row per catalog product" rule is a PARTIAL unique index
  // (WHERE product_id IS NOT NULL) added by hand in the migration SQL —
  // Prisma can't express filtered uniques in the schema.
  @@map("shopping_list")
}
