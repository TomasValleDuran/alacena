# Copy to .env

# Matches docker-compose.yml (host port 5433 to avoid clashing with other local
# Postgres on 5432). Swap for a Neon connection string later.
DATABASE_URL="postgresql://alacena:alacena@localhost:5433/alacena?schema=public"

PORT=3001

# Frontend origin allowed by CORS (Vite dev server)
ALLOWED_ORIGIN=http://localhost:5173
