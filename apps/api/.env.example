# Copy to .env

# Matches docker-compose.yml (host port 5433 to avoid clashing with other local
# Postgres on 5432). Swap for a hosted connection string in deployment.
DATABASE_URL="postgresql://alacena:alacena@localhost:5433/alacena?schema=public"

PORT=3001

# Comma-separated list of browser origins allowed by CORS (default: the Expo
# web dev server). Requests without an Origin header (native apps) always work.
ALLOWED_ORIGINS=http://localhost:8081
