# Copy to .env

# Matches docker-compose.yml (host port 5433 to avoid clashing with other local
# Postgres on 5432). Swap for a hosted connection string in deployment.
DATABASE_URL="postgresql://alacena:alacena@localhost:5433/alacena?schema=public"

# Port the API (and the web app, when served) listens on.
PORT=3001

# Comma-separated list of browser origins allowed by CORS (default: the Expo
# web dev server). Not needed when the web app is served by this same server
# (same origin). Requests without an Origin header (native apps) always work.
ALLOWED_ORIGINS=http://localhost:8081

# Directory with the exported web app (must contain index.html), served by the
# API with an SPA fallback. Default: ./public relative to the working directory
# (where the Docker image puts it). If absent, only the API is served.
# WEB_DIR=./public
